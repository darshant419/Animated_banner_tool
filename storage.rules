rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Media assets (images, videos, gifs)
    match /assets/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 50 * 1024 * 1024 // 50MB limit
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
      allow delete: if true;
    }

    // Project thumbnails
    match /thumbnails/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Export bundles
    match /exports/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 100 * 1024 * 1024;
    }
  }
}
