rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Projects Collection
    match /projects/{projectId} {
      allow read, write: if true; // In production, replace with: if request.auth != null
    }

    // Assets Metadata Collection (general library, no project)
    match /assets/{assetId} {
      allow read, write: if true; // In production, replace with: if request.auth != null
    }

    // Project-wise Assets Metadata (each banner's assets in its own subcollection)
    match /projects/{projectId}/assets/{assetId} {
      allow read, write: if true; // In production, replace with: if request.auth != null
    }

    // Banner Templates Collection (new: user-saved reusable designs)
    match /bannerTemplates/{templateId} {
      allow read, write: if true; // In production, replace with: if request.auth != null
    }

    // Templates Collection
    match /templates/{templateId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
